# Discord OAuth2 app (Discord Developer Portal > OAuth2)
# Redirect URL to register: {NEXTAUTH_URL}/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# `openssl rand -base64 33`
AUTH_SECRET=

# Public origin this app is served from (used for the OAuth callback)
NEXTAUTH_URL=http://localhost:3000

# Same MySQL database the ashi_bot.py bot already uses
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Discord webhook pointed at the bot's SURVEY_LOG_CHANNEL_ID channel.
# Vote notifications and survey announcements are skipped silently if unset.
DISCORD_WEBHOOK_URL=

# 관리자 메뉴(/admin) 노출 판별용. 로그인 시 디스코드에서 역할을 읽어
# DISCORD_ADMIN_ROLE_IDS 에 하나라도 해당하면 관리자로 본다.
# 아시바당연맹 서버 기준: 부대장 813419957671952414, 대장 807859944812576790
DISCORD_GUILD_ID=
DISCORD_ADMIN_ROLE_IDS=
