# Discord OAuth2 app (Discord Developer Portal > OAuth2)
# Redirect URL to register: {NEXTAUTH_URL}/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# `openssl rand -base64 33`
AUTH_SECRET=

# Public origin this app is served from (used for the OAuth callback)
NEXTAUTH_URL=http://localhost:3000

# Same MySQL database the ashi_bot.py bot already uses
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# 설문 공지용 디스코드 웹훅. 연맹원이 보는 설문 채널로 지정한다.
# (채널 톱니바퀴 → 연동 → 웹후크 에서 URL 복사)
# 투표 기록은 디스코드로 보내지 않는다 — 관리자 메뉴에서 본다.
DISCORD_ANNOUNCE_WEBHOOK_URL=

# 예전에 단일 웹훅으로 쓰던 값. 위가 비어 있을 때만 폴백으로 쓴다.
DISCORD_WEBHOOK_URL=

# 관리자 메뉴(/admin) 노출 판별용. 로그인 시 디스코드에서 역할을 읽어
# DISCORD_ADMIN_ROLE_IDS 에 하나라도 해당하면 관리자로 본다.
# 쉼표로 여러 역할 ID를 지정할 수 있다. 실제 값은 서버 환경변수로만 관리한다.
DISCORD_GUILD_ID=
DISCORD_ADMIN_ROLE_IDS=
