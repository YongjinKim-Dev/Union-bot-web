# Discord OAuth2 app (Discord Developer Portal > OAuth2)
# Redirect URL to register: {NEXTAUTH_URL}/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# `openssl rand -base64 33`
# 바꾸면 발급해 둔 세션이 전부 풀린다 — 모두 다시 로그인해야 한다.
AUTH_SECRET=

# Public origin this app is served from (used for the OAuth callback)
NEXTAUTH_URL=http://localhost:3000

# 리버스 프록시 뒤에서 돌 때 Host 헤더를 믿는다. Caddy 뒤에 있으므로 켜 둔다.
AUTH_TRUST_HOST=true

# Same MySQL database the ashi_bot.py bot already uses
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# 설문 공지용 디스코드 웹훅. 연맹원이 보는 설문 채널로 지정한다.
# (채널 톱니바퀴 → 연동 → 웹후크 에서 URL 복사)
# 투표 기록은 디스코드로 보내지 않는다 — 관리자 메뉴에서 본다.
#
# 이 주소를 아는 사람은 누구나 그 채널에 글을 쓸 수 있다. 비밀번호처럼 다룬다.
DISCORD_ANNOUNCE_WEBHOOK_URL=

# 예전에 단일 웹훅으로 쓰던 값. 위가 비어 있을 때만 폴백으로 쓴다.
DISCORD_WEBHOOK_URL=

# 관리자 메뉴(/admin) 노출 판별용. 로그인 시 디스코드에서 역할을 읽어
# DISCORD_ADMIN_ROLE_IDS 에 하나라도 해당하면 관리자로 본다.
# 쉼표로 여러 역할 ID를 지정할 수 있다. 실제 값은 서버 환경변수로만 관리한다.
DISCORD_GUILD_ID=
DISCORD_ADMIN_ROLE_IDS=

# ── 더는 쓰지 않는 값 ──────────────────────────────────────────────
# DISCORD_VOTE_LOG_WEBHOOK_URL
#   투표 기록을 디스코드로 보내던 시절의 웹훅. 기록을 웹으로 옮기면서
#   코드에서 읽지 않게 됐다. 아직 .env 에 남아 있다면 지워도 된다.

# 거점전 자리 스크린샷을 두는 곳 (Cloudflare R2).
# 보관함 안에서는 node-war/<지역>/<거점>/map 과 node-war/<지역>/<거점>/<자리>
# 로 나뉘어 쌓인다. 폴더를 미리 만들어 둘 필요는 없다.
# 버킷은 비공개로 둔다 — 브라우저는 R2 를 직접 부르지 않고, 사진은 전부
# /api/battle-image 를 거친다. 공개로 열 사진인지는 자리마다 따로 정한다.
#
# 계정 아이디는 R2 대시보드 주소나 버킷의 S3 엔드포인트에 들어 있다.
# 키 두 개는 R2 > API 토큰에서 발급하며, 그 버킷에 읽기·쓰기만 주면 된다.
# 이 값이 비어 있으면 사진 기능만 꺼지고 나머지 화면은 그대로 돈다.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
